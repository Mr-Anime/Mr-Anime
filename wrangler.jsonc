{
  "name": "mr-anime",
  "main": "dist/_worker.js",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mr-anime-db",
      "database_id": "REPLACE_WITH_DB_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "REPLACE_WITH_KV_ID"
    }
  ],
  "vars": {
    "SITE_URL": "http://localhost:4321",
    "OAUTH_ISSUER": "http://localhost:4321",
    "REQUIRE_LOGIN_TO_WATCH": "false"
  }
}
