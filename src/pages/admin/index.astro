---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDb } from '../../lib/db';
import { users, oauthClients, adminActions } from '../../lib/schema';
const user = (Astro.locals as any).user;
const env = (Astro.locals as any).runtime?.env;
const db = getDb(env);
const allUsers = await db.select().from(users).all();
const clients = await db.select().from(oauthClients).all();
const actions = await db.select().from(adminActions).all();
---
<BaseLayout>
  <main class="min-h-screen p-6 max-w-6xl mx-auto space-y-6">
    <h1 class="text-2xl font-bold">Admin Panel</h1>
    <div class="grid grid-cols-4 gap-4">
      <div class="bg-[#15151a] p-4 rounded">Users: {allUsers.length}</div>
      <div class="bg-[#15151a] p-4 rounded">Banned: {allUsers.filter((u:any)=>u.isBanned).length}</div>
      <div class="bg-[#15151a] p-4 rounded">Admins: {allUsers.filter((u:any)=>u.role==='admin').length}</div>
      <div class="bg-[#15151a] p-4 rounded">Clients: {clients.length}</div>
    </div>
    <div class="bg-[#15151a] p-4 rounded overflow-x-auto">
      <table class="w-full text-sm">
        <thead><tr><th class="text-left">Email</th><th>Username</th><th>Role</th><th>Verified</th><th>Banned</th></tr></thead>
        <tbody>
          {allUsers.map((u:any)=>(
            <tr><td>{u.email}</td><td>{u.username}</td><td>{u.role}</td><td>{u.isVerified?'yes':'no'}</td><td>{u.isBanned?'yes':'no'}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </main>
</BaseLayout>