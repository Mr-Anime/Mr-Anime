---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CommentSystem from "../../components/CommentSystem.astro";
import { getAnime } from "../../lib/anilist";
import { env } from "cloudflare:workers";

export const prerender = false;
const id = Number(Astro.params.id);
if (!Number.isSafeInteger(id) || id < 1) return Astro.redirect("/");

let anime: Awaited<ReturnType<typeof getAnime>> = null;
let loadError = false;
try {
  anime = await getAnime(id);
} catch (error) {
  console.error("Unable to load AniList metadata", error);
  loadError = true;
}

const episodeLimit = anime?.episodes && anime.episodes > 0 ? anime.episodes : 999;
const parsedEpisode = Number(Astro.url.searchParams.get("episode"));
const requestedEpisode = Number.isSafeInteger(parsedEpisode) ? parsedEpisode : 1;
const episode = Math.max(1, Math.min(requestedEpisode, episodeLimit));
const configuredPlayer = env.PLAYER_EMBED_BASE_URL?.trim();
let playerUrl: string | null = null;
let playerConfigurationInvalid = false;
if (configuredPlayer) {
  try {
    const url = new URL(configuredPlayer);
    if (url.protocol === "https:") {
      url.searchParams.set("anilist", String(id));
      url.searchParams.set("episode", String(episode));
      playerUrl = url.toString();
    } else {
      playerConfigurationInvalid = true;
      console.error("PLAYER_EMBED_BASE_URL must use HTTPS");
    }
  } catch {
    playerConfigurationInvalid = true;
    console.error("PLAYER_EMBED_BASE_URL must be an absolute HTTPS URL");
  }
}
---

<BaseLayout title={anime ? `${anime.title.english || anime.title.romaji} — Mr. Anime` : "Watch anime — Mr. Anime"}>
  {anime ? (
    <>
      <section class="watch-heading">
        <div class="watch-poster"><img src={anime.coverImage.extraLarge || anime.coverImage.large} alt={`Cover for ${anime.title.english || anime.title.romaji}`} /></div>
        <div class="watch-details">
          <p class="eyebrow">ANILIST · {anime.seasonYear || "ANIME"}</p>
          <h1>{anime.title.english || anime.title.romaji}</h1>
          <p class="watch-meta">{anime.episodes ? `${anime.episodes} episodes` : "Episodes"}{anime.averageScore ? ` · ${anime.averageScore}% score` : ""}</p>
          <div class="genre-list">{anime.genres.slice(0, 5).map((genre) => <span>{genre}</span>)}</div>
          <p class="anime-description">{anime.description?.replace(/<[^>]*>/g, " ").replace(/\s+/g, " ").trim() || "Discover this title on Mr. Anime."}</p>
        </div>
      </section>
      <section class="player-section">
        <div class="section-heading"><div><p class="eyebrow">NOW PLAYING</p><h2>Episode {episode}</h2></div>
          <form method="get" class="episode-picker"><label for="episode">Episode</label><input id="episode" name="episode" type="number" min="1" max={anime.episodes || 999} value={episode} /><button class="button button-quiet">Go</button></form>
        </div>
        {playerUrl ? (
          <iframe class="video-player" src={playerUrl} title={`${anime.title.english || anime.title.romaji}, episode ${episode}`} allow="autoplay; encrypted-media; fullscreen; picture-in-picture" referrerpolicy="no-referrer" sandbox="allow-scripts allow-same-origin allow-forms allow-presentation" allowfullscreen></iframe>
        ) : (
          <div class="player-placeholder"><span class="play-icon">▶</span><h3>{playerConfigurationInvalid ? "Check your player settings" : "Your next episode starts here"}</h3><p>{playerConfigurationInvalid ? "PLAYER_EMBED_BASE_URL must be an absolute HTTPS embed URL. Update it in your Cloudflare Worker variables and secrets." : "Video playback needs a provider you own or are authorized to use. Set PLAYER_EMBED_BASE_URL in your Cloudflare Worker variables to its HTTPS embed endpoint; Mr. Anime will pass the anime ID and episode number."}</p></div>
        )}
      </section>
      <CommentSystem animeId={anime.id} episode={episode} />
    </>
  ) : (
    <section class="not-found"><p class="eyebrow">TITLE NOT FOUND</p><h1>{loadError ? "Anime metadata is unavailable right now." : "We couldn't find that title."}</h1><a class="button button-primary" href="/">Back to discovery</a></section>
  )}
</BaseLayout>
