---
import BaseLayout from '../../layouts/BaseLayout.astro';
const { id } = Astro.params;
---
<BaseLayout>
  <main class="min-h-screen p-6 max-w-6xl mx-auto space-y-4">
    <h1 class="text-2xl font-bold">Anime #{id}</h1>
    <a href={'/watch/'+id+'/1'} class="px-4 py-2 bg-red-600 rounded inline-block">Watch Episode 1</a>
    <p class="text-gray-400 text-sm">Data from AniList and TMDB. This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
  </main>
</BaseLayout>