---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Your profile — Mr. Anime">
  <section class="profile-page">
    <p class="eyebrow">YOUR COLLECTION</p>
    <h1>Profile &amp; customization</h1>
    <p class="muted">Redeem a code to unlock frames and name styles. Select from items you own below.</p>
    <div class="profile-preview"><div class="preview-avatar"><span>M</span><img id="frame-preview" alt="" hidden /></div><strong id="name-preview">Your username</strong></div>
    <form class="redeem-form" id="redeem-form">
      <label for="promo-code">Promo code</label>
      <input id="promo-code" name="code" maxlength="64" required placeholder="Enter your code" />
      <button class="button button-primary">Redeem code</button>
      <p class="form-message" id="redeem-message" role="status"></p>
    </form>
    <form class="profile-form" id="profile-form">
      <label for="frame-select">Avatar frame</label><select id="frame-select" name="frameId"><option value="">No frame</option></select>
      <label for="style-select">Username style</label><select id="style-select" name="styleId"><option value="">Default</option></select>
      <button class="button button-primary">Save profile</button>
      <p class="form-message" id="profile-message" role="status"></p>
    </form>
  </section>
  <script>
    const redeemForm = document.querySelector<HTMLFormElement>("#redeem-form")!;
    const redeemMessage = document.querySelector<HTMLParagraphElement>("#redeem-message")!;
    const profileForm = document.querySelector<HTMLFormElement>("#profile-form")!;
    const profileMessage = document.querySelector<HTMLParagraphElement>("#profile-message")!;
    const frameSelect = document.querySelector<HTMLSelectElement>("#frame-select")!;
    const styleSelect = document.querySelector<HTMLSelectElement>("#style-select")!;
    const framePreview = document.querySelector<HTMLImageElement>("#frame-preview")!;
    const namePreview = document.querySelector<HTMLElement>("#name-preview")!;

    function updatePreview() {
      const selectedFrame = frameSelect.selectedOptions[0];
      framePreview.hidden = !selectedFrame?.dataset.image;
      if (selectedFrame?.dataset.image) framePreview.src = selectedFrame.dataset.image;
      namePreview.className = styleSelect.selectedOptions[0]?.dataset.cssClass || "";
    }

    async function loadProfile() {
      const response = await fetch("/api/profile");
      const result = await response.json();
      if (!response.ok) throw new Error(result.error || "Unable to load your profile.");
      frameSelect.replaceChildren(new Option("No frame", ""));
      styleSelect.replaceChildren(new Option("Default", ""));
      for (const frame of result.frames) {
        const option = document.createElement("option");
        option.value = String(frame.id);
        option.textContent = frame.name;
        option.dataset.image = frame.image_path;
        frameSelect.append(option);
      }
      for (const style of result.styles) {
        const option = document.createElement("option");
        option.value = String(style.id);
        option.textContent = style.name;
        option.dataset.cssClass = style.css_class;
        styleSelect.append(option);
      }
      frameSelect.value = result.profile?.frame_id ? String(result.profile.frame_id) : "";
      styleSelect.value = result.profile?.name_style_id ? String(result.profile.name_style_id) : "";
      namePreview.textContent = result.user.username;
      updatePreview();
    }
    loadProfile().catch((error) => { profileMessage.textContent = error.message; });
    frameSelect.addEventListener("change", updatePreview);
    styleSelect.addEventListener("change", updatePreview);

    redeemForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      redeemMessage.textContent = "";
      try {
        const response = await fetch("/api/redeem", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(redeemForm).entries())),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Unable to redeem code.");
        redeemMessage.textContent = "Reward unlocked! Your collection is updated.";
        redeemForm.reset();
        await loadProfile();
      } catch (error) {
        redeemMessage.textContent = error instanceof Error ? error.message : "Unable to redeem code.";
      }
    });

    profileForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      try {
        const data = Object.fromEntries(new FormData(profileForm).entries());
        const response = await fetch("/api/profile", {
          method: "PATCH",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ frameId: data.frameId ? Number(data.frameId) : null, styleId: data.styleId ? Number(data.styleId) : null }),
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.error || "Unable to update profile.");
        profileMessage.textContent = "Profile updated.";
      } catch (error) {
        profileMessage.textContent = error instanceof Error ? error.message : "Unable to update profile.";
      }
    });
  </script>
</BaseLayout>
