# ------------------------------------------------------------------
# Copy to .dev.vars for `wrangler pages dev` (SERVER-ONLY secrets).
# NEVER commit .dev.vars. Never prefix these with VITE_.
# ------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin panel > SMTP settings (Supabase Management API).
# Create a token at https://supabase.com/dashboard/account/tokens.
# Leave SUPABASE_ACCESS_TOKEN empty to disable the admin SMTP form locally.
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=

# Optional: configure Supabase Auth email from the deployment environment.
# When set, the admin panel reports "Configured"; with SUPABASE_ACCESS_TOKEN
# present the values are applied to the project automatically.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=Mr.Anime

APP_URL=http://localhost:8788
SEED_ADMIN_EMAIL=
# Leave empty locally — direct AniList calls work from your machine.
# In production set this to your Vercel proxy, e.g. https://mr-anime.vercel.app/api/anilist
ANILIST_ENDPOINT=
