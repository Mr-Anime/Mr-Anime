# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# anon key (older projects) / publishable key (newer projects) - same value
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# server-only, never exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- TMDB v3 (https://www.themoviedb.org/settings/api -> API Read Access Token) ---
# server-only, never exposed to the browser
TMDB_READ_ACCESS_TOKEN=tmdb_read_access_token_here

# --- Episode providers (server-built embed URLs, origins added to CSP frame-src) ---
# Add as many as you like: PROVIDER_2_BASE, PROVIDER_3_NAME, ... (up to PROVIDER_6_)
# Base URL styles:
#   template  PROVIDER_1_BASE=https://embed.example/e/{id}/{ep}
#             tokens: {id} AniList id, {ep} episode, {title} title,
#                     {tmdb} TMDB tv id (may be empty), {season} TMDB season
#   plain     PROVIDER_1_BASE=https://embed.example/e
#             -> ?id=<anilistId>&ep=<n>&season=<n>[&tmdb=<id>] is appended
PROVIDER_1_BASE=https://your-legal-embed-provider.example/e/{id}/{ep}
PROVIDER_1_NAME=Provider 1
# PROVIDER_2_BASE=
# PROVIDER_2_NAME=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = /watch requires a signed-in account, 0 = public watching
REQUIRE_LOGIN_TO_WATCH=0
# optional Google OAuth (also enable Google in Supabase Auth -> Providers)
ENABLE_GOOGLE_OAUTH=0

# --- Optional: forward "report broken video" posts to your own endpoint ---
# REPORT_WEBHOOK_URL=https://hooks.example.com/mranime-reports
