# ------------------------------------------------------------------
# Copy to .env for local Vite development (these are PUBLIC by design).
# ------------------------------------------------------------------
# Supabase project URL and anon key (safe to expose; RLS protects data).
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where `wrangler pages dev` listens when proxying /api during `npm run dev`.
# In production leave empty: /api is served by Pages Functions on same origin.
VITE_API_BASE=

# Set to true to render the UI against src/api/mock.js instead of the Workers.
VITE_USE_MOCK_API=false

# --- AniList proxy (Vercel api/anilist.js or Netlify netlify/functions/anilist.mjs) ---
# Deploy this repo to Vercel or Netlify, verify the probe, then set the
# Cloudflare Pages env var to that deployment:
#   ANILIST_ENDPOINT=https://<your-project>.vercel.app/api/anilist
#   ANILIST_ENDPOINT=https://<your-site>.netlify.app/api/anilist
# Health probe: GET <endpoint>?check=1
# (AniList blocks Cloudflare Workers' IPs, so Pages Functions can't call it directly.)
